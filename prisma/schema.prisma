// User role enum
enum UserRole {
  customer
  user
  admin
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  phone      String?   @unique
  password   String
  name       String?
  isVerified Boolean   @default(false)
  addressId  Int?
  address    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // CHANGED: Int? -> String? to match Workspace.id
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  
  assignedIssues Issue[]    @relation("IssueAssignees") 
  createdIssues  Issue[]    @relation("CreatedIssues")
  comments       Comment[]
}

model Workspace {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  users    User[]
  projects Project[]
  issues   Issue[]
  labels   Label[]
}

model Project {
  id          String    @id @default(uuid())
  name        String
  // CHANGED: Int -> String to match Workspace.id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  issues      Issue[]
}

model Issue {
  id          String    @id @default(uuid())
  identifier  String    @unique 
  title       String
  description String?   @db.Text
  status      String    @default("Todo") 
  priority    Int       @default(0)
  estimate    Int?
  dueDate     DateTime?
  gitBranch   String?

  // Hierarchy: Sub-tasks
  // CHANGED: Int? -> String? to match Issue.id
  parentId    String?
  parent      Issue?    @relation("SubTasks", fields: [parentId], references: [id])
  children    Issue[]   @relation("SubTasks")

  // Relationships: Blocking/Blocked By
  blockedBy   Issue[]   @relation("IssueRelations")
  blocking    Issue[]   @relation("IssueRelations")

  // Core Relations
  // CHANGED: Int -> String to match Workspace.id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  
  // CHANGED: Int? -> String? to match Project.id
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  
  assignees   User[]    @relation("IssueAssignees")
  
  // CHANGED: Int -> String to match User.id
  creatorId   String
  creator     User      @relation("CreatedIssues", fields: [creatorId], references: [id])
  
  labels      Label[]
  comments    Comment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Label {
   id          String    @id @default(uuid())
  name         String
  color        String
  // CHANGED: Int -> String to match Workspace.id
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  issues       Issue[]
}

model Comment {
  id        String   @id @default(uuid())
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // CHANGED: Int -> String to match Issue.id
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  
  // CHANGED: Int -> String to match User.id
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}